# ==============================================================================
# CONFIGURAÇÃO DE CONEXÃO COM O GRAFANA
# ==============================================================================
GRAFANA_URL=http://localhost:3000
GRAFANA_API_TOKEN=glsa_seu_token_de_conta_de_servico_aqui
GRAFANA_USER=admin
GRAFANA_PASSWORD=sua_senha_aqui
GRAFANA_ORG_ID=1

# ==============================================================================
# REDE, TLS E LIMITES
# ==============================================================================
GRAFANA_VERIFY_TLS=false
GRAFANA_CA_BUNDLE=
GRAFANA_TIMEOUT=30.0
GRAFANA_MAX_RESULTS=100
GRAFANA_MAX_CONCURRENT_QUERIES=10
GRAFANA_DEFAULT_TIME_RANGE=now-6h

# ==============================================================================
# RENDERIZAÇÃO DE IMAGENS (OPCIONAL)
# ==============================================================================
GRAFANA_RENDERING_ENABLED=false
GRAFANA_RENDERING_URL=http://localhost:8081/render

# ==============================================================================
# TRANSPORTE E SERVIDOR MCP
# ==============================================================================
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000
MCP_AUTH_MODE=token

# ==============================================================================
# GOVERNANÇA, RBAC E SEGURANÇA
# ==============================================================================
# Modos: 'somente_leitura' (default), 'operacional' (create/update), 'administrativo' (delete/users)
MCP_READ_ONLY=false
MCP_REQUIRE_APPROVAL_DESTRUCTIVE=true
MCP_APPROVAL_SECRET=chave-secreta-hmac-para-tokens-de-aprovacao

# ==============================================================================
# AUDITORIA E RELATÓRIOS
# ==============================================================================
MCP_AUDIT_ENABLED=true
MCP_AUDIT_PATH=./audit_grafana_mcp.jsonl
MCP_REPORT_OUTPUT_DIR=./reports_output
MCP_MAX_REPORT_SIZE=50MB
MCP_LOG_LEVEL=INFO

